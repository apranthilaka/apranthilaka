{
  "name": "bootstrap",
  "version": "1.0.0",
  "main": "index.js",
  "devDependencies": {
    "sass": "^1.87.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build-css": "sass scss/main.scss:css/app.css",
    "watch-css": "sass --watch scss/main.scss:css/app.css",
    "serve": "browser-sync start --server --files '**/*.html, **/*.css' --no-notify --open",
    "tailwind-watch": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/output.css --watch",
    "tailwind-build": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/output.css --minify"
  },
